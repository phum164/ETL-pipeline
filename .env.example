# Use a read-only PostgreSQL role for the operational database.
OLTP_DATABASE_URL=postgresql://etl_reader:change-me@host.docker.internal:5432/omsdb

# Use a separate read/write role for the isolated warehouse database.
WAREHOUSE_DATABASE_URL=postgresql://etl_writer:change-me@host.docker.internal:5432/warehouse_db

ETL_SOURCE_SYSTEM=db_oltp
ETL_CHUNK_SIZE=5000
ETL_OVERLAP_MINUTES=5
ETL_STAGING_RETENTION_DAYS=30
ETL_LOG_LEVEL=INFO
