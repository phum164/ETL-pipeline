# Match the database name and Docker network from the backend production stack.
OLTP_DATABASE_URL=postgresql://etl_reader:CHANGE_ME@postgres:5432/cfmanager
WAREHOUSE_DATABASE_URL=postgresql://etl_writer:CHANGE_ME@postgres:5432/warehouse_db

ETL_SOURCE_SYSTEM=db_oltp
ETL_CHUNK_SIZE=5000
ETL_OVERLAP_MINUTES=5
ETL_STAGING_RETENTION_DAYS=30
ETL_LOG_LEVEL=INFO
